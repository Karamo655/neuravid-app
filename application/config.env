# NEURAVID — les réglages de l'application officielle (lus par .github/workflows/application-officielle.yml).
# Changer une valeur ici demande une nouvelle version sur les magasins ; tout le reste se publie par le site.

# Le nom sous l'icône du téléphone
NOM=NEURAVID
# L'identifiant unique sur Google Play et sur l'App Store : il ne pourra PLUS JAMAIS changer après la première publication
IDENTIFIANT=com.neuravid.app
# Le numéro de version montré aux utilisateurs (le numéro de construction, lui, augmente tout seul)
VERSION=1.0.0
# Le site que l'application ouvre. Quand app.neuravid.com sera relié au site, mettre https://app.neuravid.com/
SITE=https://www.neuravid.com/
# La page de départ : l'accueil
DEPART=index.html
